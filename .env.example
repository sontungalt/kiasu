NODE_ENV=development
PORT=8080
GCP_PROJECT=your-gcp-project
GCP_REGION=asia-southeast1
PUBLIC_BASE_URL=https://example.trycloudflare.com
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-sonnet-5-5
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_PERSONAL=
GOOGLE_REFRESH_TOKEN_SCHOOL=

# Messenger: telegram (free, docs/setup-free.md) or whatsapp (Meta, docs/setup.md)
MESSENGER=telegram
TELEGRAM_BOT_TOKEN=
# Empty during setup: the server ignores messages and logs their chat id. npm run telegram:chat-id finds it.
TELEGRAM_CHAT_ID=
# openssl rand -hex 32 (must match the server; npm run telegram:webhook sends it to Telegram)
TELEGRAM_WEBHOOK_SECRET=

# Free hosting: cron-job.org sends Authorization: Bearer <JOB_SECRET> to /jobs/tick (openssl rand -hex 32)
JOB_SECRET=
# Firestore outside Google Cloud: the Firebase service-account key JSON on one line (set it in Render, not here)
FIRESTORE_CREDENTIALS_JSON=

# Cloud Run setup only (with billing). Leave empty for free hosting: Gmail is polled, the queue runs in-process.
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push
INVOKER_SERVICE_ACCOUNT=invoker@your-gcp-project.iam.gserviceaccount.com
TASKS_QUEUE=projects/your-gcp-project/locations/asia-southeast1/queues/inbound

# WhatsApp only (MESSENGER=whatsapp)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
MY_WHATSAPP_NUMBER=6500000000
CLASSROOM_ENABLED=true
DEV_SKIP_OIDC=false

# Local only. memory = no Firestore, data lost on restart (refused when NODE_ENV=production)
# STORE=memory
