NODE_ENV=development
PORT=8080
GCP_PROJECT=your-gcp-project
GCP_REGION=asia-southeast1
PUBLIC_BASE_URL=https://example.trycloudflare.com
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-sonnet-5-5
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_PERSONAL=
GOOGLE_REFRESH_TOKEN_SCHOOL=
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push
INVOKER_SERVICE_ACCOUNT=invoker@your-gcp-project.iam.gserviceaccount.com
TASKS_QUEUE=projects/your-gcp-project/locations/asia-southeast1/queues/inbound
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
MY_WHATSAPP_NUMBER=6500000000
CLASSROOM_ENABLED=true
DEV_SKIP_OIDC=false

# Local only. memory = no Firestore, data lost on restart (refused when NODE_ENV=production)
# STORE=memory
