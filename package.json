{
  "name": "kiasu-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 GCP_PROJECT=demo-inbox vitest run test/store",
    "typecheck": "tsc --noEmit",
    "eval:triage": "tsx --env-file=.env evals/triage/run.ts",
    "export:fixtures": "tsx --env-file=.env scripts/export-fixtures.ts",
    "auth": "tsx --env-file=.env scripts/auth-google.ts",
    "check:access": "tsx --env-file=.env scripts/check-access.ts",
    "setup:gcp": "bash scripts/setup-gcp.sh",
    "lint:sh": "shellcheck -x scripts/*.sh scripts/lib/*.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/tasks": "^7.3.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.3.0",
    "googleapis": "^185.0.0",
    "html-to-text": "^10.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.4"
  }
}
